# Copy to .env and fill in from Supabase → Project Settings → API.
# Then run:  python3 gen_config.py   (writes annotator/config.js, which is gitignored)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Show the "Create account" button on the sign-in gate (true/false)
SUPABASE_ALLOW_SIGNUP=true
